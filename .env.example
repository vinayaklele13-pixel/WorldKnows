# WorldKnows Environment Configuration Template
# Copy this file to .env.local and configure your providers and credentials.
# Note: Never commit actual API keys or secrets to version control.

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worldknows?schema=public

# Authentication Secret (Min 32 characters random string)
AUTH_SECRET=worldknows-super-secret-auth-key-change-in-production-1234567890

# Search Provider Configuration
# Options: mock, tavily, serpapi
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# AI / Orchestration Provider Configuration (OmniRoute)
# Options: omniroute, openai, anthropic, mock
AI_PROVIDER=omniroute
OMNIROUTE_API_KEY=local-dev-key
OMNIROUTE_BASE_URL=http://localhost:20128/v1
AI_MODEL=auto
