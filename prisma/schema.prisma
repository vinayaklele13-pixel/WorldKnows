generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  conversations    AIConversation[]
  bookmarks        Bookmark[]
  collections      Collection[]
  researchProjects ResearchProject[]
  searches         Search[]
}

model Search {
  id              String           @id @default(uuid())
  userId          String?
  query           String
  intent          String?
  summary         String?
  createdAt       DateTime         @default(now())
  collectionItems CollectionItem[]
  user            User?            @relation(fields: [userId], references: [id])
  sources         Source[]

  @@index([userId])
}

model Source {
  id                  String                    @id @default(uuid())
  searchId            String
  title               String
  url                 String
  domain              String
  snippet             String?
  reliabilityScore    Float?
  entityRelationships EntityRelationship[]
  entitySources       EntitySource[]
  entityRelationshipSources EntityRelationshipSource[]
  search              Search                    @relation(fields: [searchId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id              String           @id @default(uuid())
  userId          String
  title           String
  url             String
  notes           String?
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id])
  collectionItems CollectionItem[]

  @@index([userId])
}

model Collection {
  id          String           @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id])
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String     @id @default(uuid())
  collectionId String
  searchId     String?
  bookmarkId   String?
  createdAt    DateTime   @default(now())
  bookmark     Bookmark?  @relation(fields: [bookmarkId], references: [id])
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  search       Search?    @relation(fields: [searchId], references: [id])
}

model ResearchProject {
  id          String         @id @default(uuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime       @default(now())
  notes       ResearchNote[]
  user        User           @relation(fields: [userId], references: [id])
  entities    Entity[]       @relation("ResearchProjectEntities")
  topics      Topic[]        @relation("ResearchProjectTopics")

  @@index([userId])
}

model ResearchNote {
  id        String          @id @default(uuid())
  projectId String
  title     String
  content   String
  createdAt DateTime        @default(now())
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  messages  AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Topic {
  id               String              @id @default(uuid())
  slug             String              @unique
  name             String
  description      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  topicEntities    TopicEntity[]
  topicA           TopicRelationship[] @relation("TopicARelation")
  topicB           TopicRelationship[] @relation("TopicBRelation")
  researchProjects ResearchProject[]   @relation("ResearchProjectTopics")
}

model Entity {
  id               String               @id @default(uuid())
  name             String
  type             EntityType
  description      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sourceRelationA  EntityRelationship[] @relation("EntityARelation")
  sourceRelationB  EntityRelationship[] @relation("EntityBRelation")
  entitySources    EntitySource[]
  topicEntities    TopicEntity[]
  researchProjects ResearchProject[]    @relation("ResearchProjectEntities")

  @@unique([name, type])
}

model TopicEntity {
  id        String   @id @default(uuid())
  topicId   String
  entityId  String
  createdAt DateTime @default(now())
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, entityId])
}

model TopicRelationship {
  id          String   @id @default(uuid())
  topicAId    String
  topicBId    String
  type        String
  description String?
  createdAt   DateTime @default(now())
  topicA      Topic    @relation("TopicARelation", fields: [topicAId], references: [id], onDelete: Cascade)
  topicB      Topic    @relation("TopicBRelation", fields: [topicBId], references: [id], onDelete: Cascade)

  @@unique([topicAId, topicBId, type])
}

model EntityRelationship {
  id          String                    @id @default(uuid())
  entityAId   String
  entityBId   String
  type        String
  description String?
  sourceId    String?
  createdAt   DateTime                  @default(now())
  entityA     Entity                    @relation("EntityARelation", fields: [entityAId], references: [id], onDelete: Cascade)
  entityB     Entity                    @relation("EntityBRelation", fields: [entityBId], references: [id], onDelete: Cascade)
  source      Source?                   @relation(fields: [sourceId], references: [id])
  sources     EntityRelationshipSource[]

  @@unique([entityAId, entityBId, type])
  @@index([sourceId])
}

model EntityRelationshipSource {
  id             String             @id @default(uuid())
  relationshipId String
  sourceId       String
  createdAt      DateTime           @default(now())
  relationship   EntityRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  source         Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, sourceId])
  @@index([sourceId])
}

model EntitySource {
  id        String   @id @default(uuid())
  entityId  String
  sourceId  String
  evidence  String?
  createdAt DateTime @default(now())
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, sourceId])
  @@index([sourceId])
}

enum EntityType {
  PERSON
  ORGANIZATION
  PLACE
  EVENT
  CONCEPT
  TECHNOLOGY
  OTHER
}
